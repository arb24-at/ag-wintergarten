---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRenderedPages } from '../lib/site-pages';

const pages = getRenderedPages(await getCollection('sitePages'));
const page = pages.find((entry) => entry.id.replace(/\.md$/, '') === 'startseite');

if (!page) {
  throw new Error('The canonical homepage `startseite.md` is missing or still marked as draft.');
}

const { Content } = await render(page);
---

<BaseLayout page={page} pages={pages}>
  <Content />
</BaseLayout>
