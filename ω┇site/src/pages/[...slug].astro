---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRenderedPages } from '../lib/site-pages';

export async function getStaticPaths() {
  const pages = getRenderedPages(await getCollection('sitePages'));
  const routePages = pages.filter((page) => page.data.url !== '/');

  return routePages.map((page) => ({
    params: {
      slug: page.data.url.replace(/^\/|\/$/g, ''),
    },
    props: { page, pages },
  }));
}

const { page, pages } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout page={page} pages={pages}>
  <Content />
</BaseLayout>
