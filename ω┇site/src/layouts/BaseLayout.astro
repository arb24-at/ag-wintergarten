---
import type { SitePage } from '../lib/site-pages';
import { getRoutingPages } from '../lib/site-pages';
import CTABlock from '../components/CTABlock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RoutingCards from '../components/RoutingCards.astro';

interface Props {
  page: SitePage;
  pages: SitePage[];
}

const { page, pages } = Astro.props;
const isHome = page.data.url === '/';
const routingPages = isHome ? getRoutingPages(pages, page.data.url) : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={page.data.description} />
    <title>{page.data.title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --page-bg: #ffffff;
        --surface: #ffffff;
        --surface-quiet: #f4f8fc;
        --surface-warm: #eaf3fb;
        --surface-sage: #eef6fd;
        --surface-cool: #d9e9f7;
        --ink: #111827;
        --ink-soft: #263548;
        --muted: #5e6b7c;
        --line: #d5e0ec;
        --accent: #07468b;
        --accent-strong: #06315f;
        --accent-deep: #041f3f;
        --accent-mid: #0c5ea8;
        --accent-light: #3d82bd;
        --accent-soft: #d7e8f7;
        --accent-pale: #f4f8fc;
        --clay: #315f8f;
        --green: #1d6cae;
        --max: 960px;
        --wide: 960px;
        --measure: 690px;
        --pad: 14px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: auto;
      }

      body {
        margin: 0;
        background: var(--page-bg);
        color: var(--ink);
        font-family:
          "Open Sans", Arial, ui-sans-serif, system-ui, -apple-system,
          BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.5;
        overflow-x: hidden;
      }

      a {
        color: var(--accent-strong);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--accent);
      }

      img {
        display: block;
        max-width: 100%;
      }

      h1,
      h2,
      h3,
      p,
      li,
      a,
      span,
      strong {
        overflow-wrap: break-word;
      }

      .container {
        width: min(calc(100% - 28px), var(--wide));
        margin-inline: auto;
      }

      .site-header {
        position: relative;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid var(--line);
        background: #ffffff;
      }

      .site-header__inner {
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .brand {
        display: grid;
        gap: 1px;
        min-width: 165px;
        color: var(--ink);
        text-decoration: none;
      }

      .brand strong {
        color: var(--accent);
        font-size: 1rem;
        line-height: 1.15;
      }

      .brand span {
        max-width: 245px;
        color: var(--muted);
        font-size: 0.74rem;
        line-height: 1.25;
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
      }

      .site-nav__link,
      .site-nav__cta,
      .hero__cta,
      .button-link {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 2px;
        padding: 7px 11px;
        font-weight: 750;
        font-size: 0.8rem;
        text-decoration: none;
      }

      button.button-link {
        border: 0;
        cursor: pointer;
        font: inherit;
      }

      .site-nav__link {
        border: 1px solid transparent;
        color: var(--ink-soft);
      }

      .site-nav__link:hover,
      .site-nav__link[aria-current='page'] {
        border-color: var(--accent-soft);
        background: var(--accent-pale);
        color: var(--accent);
      }

      .site-nav__cta,
      .hero__cta,
      .button-link {
        border: 1px solid var(--accent);
        background: var(--accent);
        color: white;
      }

      .site-nav__cta:hover,
      .hero__cta:hover,
      .button-link:hover {
        border-color: var(--accent-strong);
        background: var(--accent-strong);
        color: white;
      }

      main {
        overflow: hidden;
      }

      .page-hero {
        position: relative;
        min-height: 330px;
        display: grid;
        align-items: center;
        overflow: hidden;
        padding: 0;
        border-bottom: 4px solid var(--accent);
        background: var(--accent-deep);
      }

      .page-hero--service {
        min-height: 318px;
      }

      .page-hero__image {
        position: absolute;
        inset: 0;
        width: 100%;
        max-width: none;
        height: 100%;
        overflow: hidden;
        min-height: 100%;
        border-radius: 0;
        background: var(--accent-deep);
        box-shadow: none;
      }

      .page-hero__image img {
        width: 100%;
        height: 100%;
        min-height: inherit;
        object-fit: cover;
        opacity: 0.72;
      }

      .page-hero__image::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(4, 31, 63, 0.72), rgba(7, 70, 139, 0.22) 48%, rgba(4, 31, 63, 0.64)),
          linear-gradient(0deg, rgba(4, 23, 48, 0.5), rgba(4, 23, 48, 0.08));
        pointer-events: none;
      }

      .page-hero__inner {
        position: relative;
        z-index: 1;
        width: min(calc(100% - 28px), var(--wide));
        display: grid;
        justify-items: end;
        margin-top: 0;
        padding: 32px 0 28px;
      }

      .page-hero__card {
        min-width: 0;
        width: min(100%, 420px);
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-top: 4px solid #ffffff;
        border-radius: 0;
        background: rgba(7, 70, 139, 0.95);
        color: white;
        padding: 18px 20px 16px;
        text-align: left;
        box-shadow: 0 16px 30px rgba(3, 20, 42, 0.32);
      }

      .page-hero__eyebrow {
        margin: 0 0 8px;
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .page-hero h1 {
        margin: 0;
        max-width: 100%;
        font-size: clamp(1.62rem, 2.6vw, 2.12rem);
        line-height: 1.07;
        letter-spacing: 0;
      }

      .page-hero--service h1 {
        max-width: 100%;
        font-size: clamp(1.56rem, 2.5vw, 2.02rem);
      }

      .page-hero__summary {
        margin: 8px 0 0;
        max-width: 370px;
        color: rgba(255, 255, 255, 0.88);
        font-size: 0.84rem;
        line-height: 1.45;
      }

      .page-hero__facts {
        display: flex;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 4px;
        margin: 10px 0 0;
        padding: 0;
        list-style: none;
      }

      .page-hero__facts li {
        min-width: 0;
        flex: 0 1 auto;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 0;
        background: rgba(255, 255, 255, 0.1);
        padding: 4px 7px;
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.68rem;
        font-weight: 750;
        line-height: 1.25;
      }

      .page-hero__actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 7px;
        flex-wrap: wrap;
        margin-top: 12px;
      }

      .page-hero .hero__cta {
        border-color: white;
        background: white;
        color: var(--accent);
      }

      .page-hero .hero__cta:hover {
        background: #edf4ff;
        color: var(--accent-strong);
      }

      .page-hero .hero__cta--secondary {
        border: 1px solid rgba(255, 255, 255, 0.5);
        background: rgba(255, 255, 255, 0.08);
        color: white;
      }

      .page-hero .hero__cta--secondary:hover {
        background: rgba(255, 255, 255, 0.12);
        color: white;
      }

      .page-hero__note {
        margin: 8px 0 0;
        color: rgba(255, 255, 255, 0.76);
        font-size: 0.78rem;
      }

      .page-main {
        min-width: 0;
        padding: 18px 0 0;
      }

      .page-routing {
        width: min(calc(100% - 28px), var(--max));
        margin: 0 auto 20px;
      }

      .routing-module {
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(210px, 0.58fr) minmax(0, 1.42fr);
        gap: 18px;
        align-items: stretch;
        border: 1px solid var(--line);
        border-top: 4px solid var(--accent);
        border-radius: 0;
        background: var(--surface);
        padding: 15px;
        box-shadow: none;
      }

      .module-heading {
        display: grid;
        align-content: center;
        gap: 8px;
      }

      .module-heading p,
      .module-heading h2 {
        margin: 0;
      }

      .module-heading h2 {
        font-size: 1.16rem;
        line-height: 1.2;
      }

      .module-heading p {
        max-width: 760px;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .routing-grid {
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .routing-card {
        min-width: 0;
        display: grid;
        align-content: space-between;
        gap: 10px;
        min-height: 130px;
        border: 1px solid var(--line);
        border-radius: 0;
        background: #fbfdff;
        padding: 12px;
        color: var(--ink);
        text-decoration: none;
      }

      .routing-card:hover {
        border-color: var(--accent);
        background: #f8fbff;
        color: var(--ink);
      }

      .routing-card h3 {
        margin: 0 0 6px;
        font-size: 0.92rem;
        line-height: 1.25;
      }

      .routing-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.42;
      }

      .routing-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin: 9px 0 0;
        padding: 0;
        list-style: none;
      }

      .routing-card__tags li {
        border-radius: 2px;
        background: var(--accent-pale);
        padding: 3px 6px;
        color: var(--ink-soft);
        font-size: 0.68rem;
        font-weight: 750;
        line-height: 1.25;
      }

      .routing-card__link {
        color: var(--accent-strong);
        font-size: 0.78rem;
        font-weight: 800;
      }

      .page-content {
        min-width: 0;
        max-width: 100%;
      }

      .page-content > h1:first-child {
        display: none;
      }

      .page-content > p {
        width: min(calc(100% - 28px), var(--max));
        margin: 0 auto 9px;
        color: var(--ink-soft);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .page-content > h1:first-child + p {
        border-left: 4px solid var(--accent);
        background: var(--accent-pale);
        padding: 12px 14px;
      }

      .page-content > p + p {
        margin-bottom: 20px;
      }

      .content-section {
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(var(--pad), 1fr) minmax(0, var(--max)) minmax(var(--pad), 1fr);
        align-items: start;
        border-top: 0;
        background: #ffffff;
        padding: 12px 0;
      }

      .content-section > * {
        grid-column: 2;
        min-width: 0;
      }

      .content-section:nth-of-type(odd):not(.content-section--process):not(.content-section--request) {
        background: #ffffff;
      }

      .content-section--diagnostic-grid,
      .content-section--faq {
        background: #ffffff;
      }

      .content-section--compact-explainer,
      .content-section--request {
        background: #ffffff;
      }

      .content-section h2 {
        max-width: 100%;
        margin: 0 0 12px;
        border-bottom: 2px dotted var(--line);
        padding-bottom: 6px;
        color: var(--accent-strong);
        font-size: 1.18rem;
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: 0;
      }

      .content-section h2::before {
        content: '';
        display: block;
        width: 90px;
        height: 2px;
        margin: 0 0 6px;
        border-radius: 0;
        background: var(--accent);
      }

      .content-section h3 {
        max-width: var(--measure);
        margin: 12px 0 5px;
        color: var(--accent-strong);
        font-size: 0.96rem;
        font-weight: 700;
        line-height: 1.32;
      }

      .content-section p,
      .content-section li {
        max-width: var(--measure);
        font-size: 0.86rem;
        line-height: 1.48;
      }

      .content-section p {
        margin: 0 0 9px;
      }

      .content-section ul,
      .content-section ol {
        min-width: 0;
        max-width: var(--measure);
        margin: 10px 0 12px;
        padding-left: 18px;
      }

      .content-section li + li {
        margin-top: 4px;
      }

      .content-section--diagnostic-grid h2,
      .content-section--diagnostic-grid > p {
        max-width: var(--max);
      }

      .content-section--diagnostic-grid ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        max-width: 100%;
        padding-left: 0;
        list-style: none;
      }

      .content-section--diagnostic-grid li {
        min-height: 58px;
        display: flex;
        align-items: flex-start;
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent-mid);
        border-radius: 0;
        background: #fbfdff;
        padding: 8px 10px;
        box-shadow: none;
      }

      .content-section--diagnostic-grid li:nth-child(3n + 2) {
        border-left-color: var(--accent);
      }

      .content-section--diagnostic-grid li:nth-child(3n + 3) {
        border-left-color: var(--accent-light);
      }

      .content-section--checkerboard {
        grid-template-columns:
          minmax(var(--pad), 1fr)
          minmax(0, 320px)
          minmax(0, 606px)
          minmax(var(--pad), 1fr);
        column-gap: 20px;
        align-items: start;
        border-top: 1px solid var(--line);
        background: #ffffff;
        padding: 18px 0;
      }

      .content-section--checkerboard.content-section--media-right {
        grid-template-columns:
          minmax(var(--pad), 1fr)
          minmax(0, 606px)
          minmax(0, 320px)
          minmax(var(--pad), 1fr);
        background: #ffffff;
      }

      .content-section--checkerboard > * {
        grid-column: 3;
      }

      .content-section--media-left > h2,
      .content-section--media-left > p:not(:has(> img)),
      .content-section--media-left > ul,
      .content-section--media-left > ol,
      .content-section--media-left > h3,
      .content-section--media-left > .section-cta {
        grid-column: 3;
      }

      .content-section--media-left > p:has(> img) {
        grid-column: 2;
        grid-row: 1 / span 12;
      }

      .content-section--media-right > h2,
      .content-section--media-right > p:not(:has(> img)),
      .content-section--media-right > ul,
      .content-section--media-right > ol,
      .content-section--media-right > h3,
      .content-section--media-right > .section-cta {
        grid-column: 2;
      }

      .content-section--media-right > p:has(> img) {
        grid-column: 3;
        grid-row: 1 / span 12;
      }

      .content-section--checkerboard h2 {
        max-width: 100%;
        margin-bottom: 10px;
      }

      .content-section--checkerboard p,
      .content-section--checkerboard li {
        max-width: 100%;
      }

      .content-section--checkerboard ul,
      .content-section--checkerboard ol,
      .content-section--compact-explainer ul {
        display: grid;
        gap: 5px;
        max-width: 100%;
        padding-left: 0;
        list-style: none;
      }

      .content-section--checkerboard li,
      .content-section--compact-explainer li {
        position: relative;
        padding-left: 18px;
      }

      .content-section--checkerboard li::before,
      .content-section--compact-explainer li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.72em;
        width: 6px;
        height: 6px;
        border-radius: 0;
        background: var(--accent-mid);
      }

      .content-section--compact-explainer {
        grid-template-columns:
          minmax(var(--pad), 1fr)
          minmax(210px, 300px)
          minmax(0, 626px)
          minmax(var(--pad), 1fr);
        column-gap: 20px;
        border-top: 1px solid var(--line);
        background: var(--surface-quiet);
      }

      .content-section--compact-explainer > h2 {
        grid-column: 2;
      }

      .content-section--compact-explainer > p,
      .content-section--compact-explainer > ul,
      .content-section--compact-explainer > ol,
      .content-section--compact-explainer > h3,
      .content-section--compact-explainer > .section-cta {
        grid-column: 3;
      }

      .content-section--compact-explainer h2 {
        font-size: 1.08rem;
      }

      .content-section--compact-explainer ul {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 6px 12px;
        max-width: 100%;
      }

      .content-section--process h3,
      .content-section--faq h3 {
        max-width: 100%;
        border: 0;
        border-radius: 0;
        background: transparent;
        padding: 0;
        box-shadow: none;
      }

      .content-section--process h3 + p,
      .content-section--faq h3 + p {
        max-width: 820px;
        margin-top: 0;
        padding: 0;
      }

      .content-section--process {
        border-top: 0;
        background: var(--accent-strong);
        color: white;
        padding: 24px 0;
      }

      .content-section--process > h2,
      .content-section--process > p {
        max-width: var(--max);
      }

      .content-section--process > h2 {
        border-bottom-color: rgba(255, 255, 255, 0.24);
      }

      .content-section--process h2,
      .content-section--process p,
      .content-section--process li {
        color: white;
      }

      .content-section--process h2::before {
        background: #9fc1d8;
      }

      .content-section--process h3 {
        color: white;
      }

      .content-section--process h3 + p {
        color: rgba(255, 255, 255, 0.82);
      }

      .content-section--process .section-items {
        grid-column: 2;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        margin-top: 2px;
      }

      .content-section--process .section-item {
        min-width: 0;
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-top: 3px solid #b9d5ee;
        background: rgba(255, 255, 255, 0.08);
        padding: 10px;
      }

      .content-section--process .section-item h3 {
        margin: 0 0 6px;
        font-size: 0.9rem;
      }

      .content-section--process .section-item p {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.42;
      }

      .content-section--faq {
        padding: 18px 0 24px;
      }

      .content-section--faq .section-items {
        grid-column: 2;
        display: grid;
        gap: 6px;
      }

      .content-section--faq .section-item {
        border: 1px solid var(--line);
        border-left: 4px solid var(--accent);
        background: #fbfdff;
        padding: 9px 11px;
      }

      .content-section--faq .section-item h3 {
        margin: 0;
        font-size: 0.9rem;
      }

      .content-section--faq .section-item p {
        max-width: 880px;
        margin: 6px 0 0;
        color: var(--ink-soft);
        font-size: 0.82rem;
      }

      .content-section--faq h3 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
      }

      .content-section--faq h3::after {
        content: '+';
        flex: 0 0 auto;
        color: var(--accent);
        font-size: 0.96rem;
      }

      .content-section--request {
        position: relative;
        text-align: left;
        border-top: 0;
        background: var(--accent-pale);
        padding: 18px 0;
      }

      .content-section--request h2,
      .content-section--request p,
      .content-section--request .section-cta {
        justify-self: start;
      }

      .content-section--request p {
        max-width: 800px;
      }

      .section-cta {
        width: fit-content;
        max-width: 100%;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed var(--accent-light);
        border-radius: 0;
        background: var(--accent-pale);
        padding: 7px 12px;
        color: var(--accent-strong);
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none;
      }

      .section-cta:hover {
        border-style: solid;
        background: var(--accent);
        color: white;
      }

      .page-content p:has(> img) {
        display: grid;
        gap: 0;
        width: 100%;
        max-width: 100%;
        margin: 0;
      }

      .page-content p:has(> img) img {
        width: 100%;
        min-height: 0;
        aspect-ratio: 4 / 3;
        border: 1px solid var(--line);
        border-radius: 0;
        background: var(--surface-cool);
        object-fit: cover;
        box-shadow: none;
      }

      .content-section--checkerboard p:has(> img) img {
        aspect-ratio: 4 / 3;
        border-top: 4px solid var(--accent);
      }

      .closing-wrap {
        margin-top: 0;
        padding: 28px 0 28px;
        background:
          linear-gradient(180deg, var(--accent-strong), var(--accent-deep));
      }

      .cta-block {
        position: relative;
        min-width: 0;
        margin: 0 auto;
        padding: 0;
        border-radius: 0;
        background: transparent;
        color: white;
      }

      .anchor-target {
        position: absolute;
        top: -96px;
      }

      .cta-block__grid {
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 18px;
        align-items: start;
      }

      .cta-block__eyebrow {
        margin: 0 0 6px;
        color: rgba(255, 255, 255, 0.74);
        font-size: 0.7rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .cta-block h2 {
        margin: 0 0 8px;
        max-width: 620px;
        font-size: 1.42rem;
        line-height: 1.16;
      }

      .cta-block p {
        max-width: 680px;
        margin: 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.84rem;
      }

      .cta-block__checklist {
        display: grid;
        gap: 6px;
        max-width: 560px;
        margin: 13px 0 0;
        padding: 0;
        list-style: none;
      }

      .cta-block__checklist li {
        border-left: 3px solid #b9d5ee;
        border-radius: 0;
        background: rgba(255, 255, 255, 0.08);
        padding: 7px 9px;
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.82rem;
        line-height: 1.35;
      }

      .enquiry-form {
        min-width: 0;
        display: grid;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-top: 4px solid #ffffff;
        border-radius: 0;
        background: rgba(255, 255, 255, 0.97);
        color: var(--ink);
        padding: 14px;
        box-shadow: none;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .enquiry-form label {
        display: grid;
        gap: 4px;
        color: var(--ink-soft);
        font-size: 0.78rem;
        font-weight: 800;
      }

      .enquiry-form input,
      .enquiry-form select,
      .enquiry-form textarea {
        width: 100%;
        min-width: 0;
        border: 1px solid #cbd9e8;
        border-radius: 0;
        background: #ffffff;
        color: var(--ink);
        font: inherit;
        font-size: 0.82rem;
        line-height: 1.35;
        padding: 7px 8px;
      }

      .enquiry-form input:focus,
      .enquiry-form select:focus,
      .enquiry-form textarea:focus {
        outline: 2px solid var(--accent-soft);
        border-color: var(--accent);
      }

      .enquiry-form textarea {
        resize: vertical;
      }

      .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
      }

      .button-link--ghost {
        border: 1px solid var(--line);
        background: #ffffff;
        color: var(--accent-strong);
      }

      .button-link--ghost:hover {
        border-color: var(--accent);
        background: var(--surface-quiet);
        color: var(--accent-strong);
      }

      .form-note {
        color: var(--muted) !important;
        font-size: 0.74rem;
        line-height: 1.45;
      }

      .form-output {
        display: block;
        min-height: 0;
        white-space: pre-wrap;
        border-radius: 0;
        background: var(--surface-quiet);
        color: var(--ink-soft);
        font-size: 0.78rem;
        line-height: 1.45;
      }

      .form-output:not(:empty) {
        margin-top: 2px;
        padding: 12px;
      }

      .contact-block {
        min-width: 0;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-top: 4px solid var(--accent-light);
        border-radius: 0;
        background: rgba(255, 255, 255, 0.94);
        color: var(--ink);
        padding: 12px;
      }

      .contact-block--plain {
        border-color: var(--line);
        background: var(--surface);
      }

      .cta-block > .contact-block {
        margin-top: 14px;
        border-color: rgba(255, 255, 255, 0.2);
        border-top-color: #b9d5ee;
        background: rgba(255, 255, 255, 0.08);
        color: white;
      }

      .cta-block > .contact-block h2,
      .cta-block > .contact-block h3 {
        color: white;
      }

      .cta-block > .contact-block p {
        color: rgba(255, 255, 255, 0.76) !important;
      }

      .cta-block > .contact-block .contact-channels {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .cta-block > .contact-block .contact-channel {
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.94);
      }

      .contact-block h2,
      .contact-block h3 {
        margin: 0 0 6px;
        font-size: 0.96rem;
        line-height: 1.25;
      }

      .contact-block p,
      .cta-block .contact-block p {
        margin: 0 0 9px;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .contact-channels {
        display: grid;
        gap: 6px;
      }

      .contact-channel {
        min-width: 0;
        min-height: 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid var(--line);
        border-radius: 0;
        background: var(--surface-quiet);
        padding: 7px 9px;
        color: var(--ink);
        font-size: 0.78rem;
      }

      .contact-channel strong {
        font-size: 0.8rem;
      }

      .contact-channel span {
        color: var(--muted);
        font-size: 0.72rem;
        text-align: right;
      }

      a.contact-channel {
        background: var(--accent);
        color: white;
        text-decoration: none;
      }

      a.contact-channel span {
        color: rgba(255, 255, 255, 0.82);
      }

      .site-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        background: var(--accent-deep);
        color: rgba(255, 255, 255, 0.78);
        padding: 24px 0;
      }

      .site-footer a {
        color: white;
      }

      .site-footer__grid {
        display: grid;
        grid-template-columns: minmax(260px, 1.25fr) minmax(170px, 0.55fr) minmax(240px, 0.8fr);
        gap: 22px;
      }

      .site-footer h2,
      .site-footer h3,
      .site-footer p {
        margin: 0;
      }

      .site-footer h2 {
        color: white;
        font-size: 0.98rem;
      }

      .site-footer h3 {
        margin-bottom: 8px;
        color: white;
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .site-footer p {
        max-width: 470px;
        margin-top: 7px;
        font-size: 0.78rem;
      }

      .footer-nav,
      .footer-contact {
        display: grid;
        gap: 5px;
        font-size: 0.78rem;
      }

      .footer-nav a {
        width: fit-content;
      }

      .footer-contact span {
        color: rgba(255, 255, 255, 0.84);
      }

      @media (max-width: 900px) {
        .site-header {
          position: static;
        }

        .site-header__inner,
        .cta-block__grid,
        .site-footer__grid {
          grid-template-columns: 1fr;
        }

        .site-header__inner {
          display: grid;
          align-items: start;
          padding: 16px 0;
        }

        .site-nav {
          justify-content: flex-start;
        }

        .routing-module {
          grid-template-columns: 1fr;
        }

        .page-hero {
          min-height: 330px;
          padding-top: 0;
        }

        .page-hero__image {
          min-height: 100%;
        }

        .page-hero__inner {
          width: min(calc(100% - 28px), var(--max));
          justify-items: center;
          margin-top: 0;
          padding: 30px 0 24px;
        }

        .content-section,
        .content-section--checkerboard,
        .content-section--compact-explainer {
          grid-template-columns: minmax(var(--pad), 1fr) minmax(0, var(--max)) minmax(var(--pad), 1fr);
        }

        .content-section > *,
        .content-section > h2,
        .content-section--checkerboard > *,
        .content-section--checkerboard > h2,
        .content-section--checkerboard > p:not(:has(> img)),
        .content-section--checkerboard > ul,
        .content-section--checkerboard > ol,
        .content-section--checkerboard > h3,
        .content-section--checkerboard > p:has(> img),
        .content-section--compact-explainer > *,
        .content-section--compact-explainer > h2,
        .content-section--compact-explainer > p,
        .content-section--compact-explainer > ul,
        .content-section--compact-explainer > ol,
        .content-section--compact-explainer > h3,
        .content-section--process .section-items,
        .content-section--faq .section-items {
          grid-column: 2;
          grid-row: auto;
        }

        .content-section--checkerboard.content-section--media-right {
          background: #ffffff;
        }

        .content-section--diagnostic-grid ul,
        .content-section--compact-explainer ul {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .content-section--process .section-items {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .content-section h2 {
          margin-bottom: 18px;
        }

        .routing-card {
          min-height: 0;
        }

        .cta-block > .contact-block .contact-channels,
        .form-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 560px) {
        :root {
          --pad: 10px;
        }

        .container {
          width: min(calc(100% - 20px), var(--max));
        }

        .site-header__inner {
          gap: 14px;
        }

        .site-nav {
          gap: 6px;
        }

        .site-nav__link,
        .site-nav__cta,
        .hero__cta,
        .button-link {
          min-height: 38px;
          padding: 8px 10px;
          font-size: 0.86rem;
        }

        .page-hero h1,
        .page-hero--service h1 {
          font-size: clamp(1.72rem, 7.4vw, 2.05rem);
          line-height: 1.02;
        }

        .page-hero__image {
          min-height: 100%;
        }

        .page-hero__inner {
          margin-top: 0;
          padding: 24px 0 22px;
        }

        .page-hero__card {
          width: calc(100vw - 20px);
          max-width: calc(100vw - 20px);
          padding: 16px;
        }

        .page-hero h1,
        .page-hero__summary,
        .page-hero__note {
          max-width: 100%;
        }

        .page-hero__summary {
          font-size: 1rem;
        }

        .page-hero__facts {
          gap: 6px;
          margin-top: 14px;
        }

        .page-hero__actions {
          align-items: flex-start;
          flex-direction: column;
        }

        .routing-module,
        .routing-card,
        .contact-block {
          padding: 18px;
        }

        .routing-grid,
        .content-section--diagnostic-grid ul,
        .content-section--checkerboard ul,
        .content-section--compact-explainer ul {
          grid-template-columns: 1fr;
        }

        .page-content > p {
          width: calc(100vw - 20px);
          max-width: calc(100vw - 20px);
          margin: 0 10px 18px;
        }

        .content-section,
        .content-section--checkerboard,
        .content-section--compact-explainer {
          display: block;
          padding: 28px 10px;
        }

        .content-section > * {
          width: calc(100vw - 20px);
          max-width: calc(100vw - 20px);
          margin-left: 0;
          margin-right: 0;
        }

        .content-section--process .section-items,
        .content-section--faq .section-items {
          width: calc(100vw - 20px);
          max-width: calc(100vw - 20px);
          grid-template-columns: 1fr;
        }

        .content-section p,
        .content-section li,
        .content-section h2,
        .content-section h3 {
          max-width: 100%;
        }

        .contact-channel {
          align-items: flex-start;
          flex-direction: column;
          gap: 2px;
        }

        .contact-channel span {
          text-align: left;
        }
      }
    </style>
  </head>
  <body data-page-type={page.data.page_type}>
    <Header pages={pages} currentUrl={page.data.url} />
    <main>
      <Hero page={page} />
      <div class="page-main">
        {
          isHome && routingPages.length > 0 && (
            <div class="page-routing container">
              <RoutingCards pages={routingPages} currentUrl={page.data.url} />
            </div>
          )
        }
        <article class="page-content">
          <slot />
        </article>
        <div class="closing-wrap">
          <div class="container">
            <CTABlock />
          </div>
        </div>
      </div>
    </main>
    <Footer pages={pages} />
  </body>
</html>
