---
import type { SitePage } from '../lib/site-pages';
import { contactChannels } from '../lib/contact';
import { getPageLabel } from '../lib/site-pages';
import { withBase } from '../lib/urls';

interface Props {
  pages: SitePage[];
  currentUrl: string;
}

const { pages, currentUrl } = Astro.props;
const phoneChannel = contactChannels.find((channel) => channel.label === 'Telefon' && channel.href);
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href={withBase('/')}>
      <strong>AG Wintergarten</strong>
      <span>Reparatur, Abdichtung und Sanierung bestehender Wintergärten</span>
    </a>
    <nav class="site-nav" aria-label="Hauptnavigation">
      {
        pages.map((page) => (
          <a
            class="site-nav__link"
            href={withBase(page.data.url)}
            aria-current={page.data.url === currentUrl ? 'page' : undefined}
          >
            {getPageLabel(page)}
          </a>
        ))
      }
      {
        phoneChannel?.href && (
          <a class="site-nav__phone" href={phoneChannel.href} aria-label={`Telefonisch anfragen: ${phoneChannel.note}`}>
            {phoneChannel.note}
          </a>
        )
      }
      <a class="site-nav__cta" href="#kontakt">Anfrage</a>
    </nav>
  </div>
</header>
