---
import type { SitePage } from '../lib/site-pages';
import { getPageCardSummary, getPageCardTitle } from '../lib/site-pages';
import { withBase } from '../lib/urls';

interface Props {
  pages: SitePage[];
  currentUrl: string;
}

const { pages } = Astro.props;
const cardDetails: Record<string, { label: string; value: string }[]> = {
  '/wintergarten-reparatur-berlin/': [
    { label: 'Typische Bauteile', value: 'Dichtungen, Glas, Platten, Profile' },
    { label: 'Ziel', value: 'Schaden erhalten, reparieren oder sanieren' },
  ],
  '/wintergarten-undicht/': [
    { label: 'Typische Lage', value: 'Dach, Anschluss, Profil oder Entwässerung' },
    { label: 'Ziel', value: 'Ursache prüfen, nicht nur Tropfstelle abdichten' },
  ],
};
---

<section class="routing-module" aria-labelledby="routing-heading">
  <div class="module-heading">
    <p class="module-heading__eyebrow">Thema wählen</p>
    <h2 id="routing-heading">Welcher Einstieg passt?</h2>
    <p>Wählen Sie die Seite, die dem sichtbaren Problem am nächsten kommt. Die Anfrage kann trotzdem kurz bleiben.</p>
  </div>
  <div class="routing-grid">
    {
      pages.map((page) => (
        <a class="routing-card" href={withBase(page.data.url)}>
          <div class="routing-card__body">
            <h3>{getPageCardTitle(page)}</h3>
            <p>{getPageCardSummary(page)}</p>
            <dl class="routing-card__details">
              {(cardDetails[page.data.url] ?? []).map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <span class="routing-card__link">Seite öffnen</span>
        </a>
      ))
    }
  </div>
</section>
