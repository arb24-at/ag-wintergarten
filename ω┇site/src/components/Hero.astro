---
import type { SitePage } from '../lib/site-pages';
import { businessDetails } from '../lib/contact';
import { withBase } from '../lib/urls';

interface Props {
  page: SitePage;
}

const { page } = Astro.props;
const isHome = page.data.url === '/';
const heroTitle = page.data.hero_title ?? page.data.title;
const heroImage = page.data.hero_image ?? '/images/placeholders/wintergarten-hero.svg';
const heroAlt = page.data.hero_image_alt ?? 'Stilisierte Darstellung eines Wintergartens';
const isProblemPage = page.data.page_type.includes('problem');
const eyebrow = isHome ? 'Reparatur und Sanierung' : isProblemPage ? 'Wassereintritt prüfen' : 'Wintergarten Reparatur';
const signals = isHome
  ? [
      { label: 'Schwerpunkt', value: 'Leckage, Abdichtung und Reparatur' },
      { label: 'Anlagen', value: 'Bestehende Wintergärten und Überdachungen' },
      { label: 'Region', value: businessDetails.serviceArea },
    ]
  : isProblemPage
    ? [
        { label: 'Problem', value: 'Wasser nach Regen, Dach oder Anschluss' },
        { label: 'Prüfung', value: 'Dichtungen, Profile und Entwässerung' },
        { label: 'Start', value: 'Kurze Beschreibung genügt zuerst' },
      ]
    : [
        { label: 'Bauteile', value: 'Dichtungen, Verglasung und Profile' },
        { label: 'Umfang', value: 'Reparatur bis Sanierung prüfen' },
        { label: 'Region', value: businessDetails.serviceArea },
      ];
const secondaryAction = isHome
  ? { href: '/wintergarten-undicht/', label: 'Wassereintritt einordnen' }
  : isProblemPage
    ? { href: '/wintergarten-reparatur-berlin/', label: 'Reparaturumfang prüfen' }
    : { href: '/wintergarten-undicht/', label: 'Undichtigkeit prüfen' };
---

<section class:list={['page-hero', !isHome && 'page-hero--service']}>
  <div class="page-hero__image container" aria-hidden={heroAlt ? undefined : 'true'}>
    <img src={withBase(heroImage)} alt={heroAlt} loading="eager" decoding="async" />
  </div>
  <div class="page-hero__inner container">
    <div class="page-hero__card">
      <p class="page-hero__eyebrow">{eyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="page-hero__summary">{page.data.description}</p>
      <ul class="page-hero__signals" aria-label="Seitenschwerpunkte">
        {signals.map((signal) => <li><strong>{signal.label}</strong><span>{signal.value}</span></li>)}
      </ul>
      <div class="page-hero__actions">
        <a class="hero__cta" href="#kontakt">Zum Anfragebereich</a>
        <a class="hero__text-link" href={withBase(secondaryAction.href)}>{secondaryAction.label}</a>
      </div>
      <p class="page-hero__note">Sie können zuerst kurz Kontakt aufnehmen. Fotos und Details helfen, wenn sie schon vorhanden sind.</p>
    </div>
  </div>
</section>
