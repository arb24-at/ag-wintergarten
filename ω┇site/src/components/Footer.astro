---
import type { SitePage } from '../lib/site-pages';
import { getPageLabel } from '../lib/site-pages';
import { businessDetails, contactChannels } from '../lib/contact';
import { withBase } from '../lib/urls';

interface Props {
  pages: SitePage[];
}

const { pages } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__grid container">
    <section>
      <div class="site-footer__brand">
        <img src={withBase('/images/brand/ag-wintergarten-rain-logo.png')} alt="" width="42" height="42" />
        <h2>AG Wintergarten</h2>
      </div>
      <p>
        Reparatur, Abdichtung, Schadensprüfung und Sanierung bestehender Wintergärten,
        Kaltwintergärten, Warmwintergärten und Terrassenüberdachungen in {businessDetails.serviceArea}.
      </p>
      <p class="site-footer__address">{businessDetails.address}</p>
    </section>
    <nav class="footer-nav" aria-label="Footer Navigation">
      <h3>Seiten</h3>
      {pages.map((page) => <a href={withBase(page.data.url)}>{getPageLabel(page)}</a>)}
    </nav>
    <section class="footer-contact" aria-label="Kontaktwege">
      <h3>Kontaktwege</h3>
      {contactChannels.map((channel) => <span>{channel.label} · {channel.note}</span>)}
    </section>
  </div>
</footer>
